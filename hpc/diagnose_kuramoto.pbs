#!/bin/bash
# Diagnostic sweep: why does CF-EES diverge at N=1000 over long training while
# CG2 stays stable? Varies solver (cfees25 vs higher-order cfees27), adjoint
# (reversible O(1) vs exact checkpoint_recursive), lr, and n_steps (step size),
# at the calibrated architecture (h=256, d=3, gc=1.0), seed 0.
# See experiments/kuramoto/scripts/run_calibration.py::GRIDS["diagnostic"].
#
# One array task per grid point; resumable + skip-if-done. Prereqs: env built,
# N=1000 dataset generated.
#
#   # confirm the grid size (it sets the array range):
#   python -m experiments.kuramoto.scripts.run_calibration --grid diagnostic --list
#   qsub hpc/diagnose_kuramoto.pbs
#   # cheaper/faster (catches divergence earlier): qsub -v EPOCHS=20 hpc/diagnose_kuramoto.pbs
#   # then rank:
#   python -m experiments.kuramoto.scripts.run_calibration --grid diagnostic --summarize \
#       --output-base experiments/kuramoto/results/diagnostic_N1000/
#
# If you edit the diagnostic grid, update the -J range below to 0-(size-1).
#
#PBS -N kuramoto_diag
#PBS -l select=1:ncpus=8:mem=64gb:ngpus=1:gpu_type=L40S
#PBS -l walltime=12:00:00
#PBS -J 0-23
#PBS -j oe

set -euo pipefail
cd "${PBS_O_WORKDIR:-$PWD}"

source hpc/conda_init.sh
conda activate "${ENV_NAME:-ees}"
export XLA_PYTHON_CLIENT_PREALLOCATE=false
export PYTHONUNBUFFERED=1
export JAX_CAPTURED_CONSTANTS_WARN_BYTES=-1   # silence the ~8GB dataset-constant warning

IDX="${PBS_ARRAY_INDEX:-0}"
EPOCHS="${EPOCHS:-25}"   # enough to see late divergence + near-converged quality
mkdir -p hpc/logs
LOG="hpc/logs/diag_idx${IDX}.log"
echo "[diag] idx=${IDX} epochs=${EPOCHS}  live log: $LOG"

python -m experiments.kuramoto.scripts.run_calibration \
    --grid diagnostic \
    --index "${IDX}" \
    --config experiments/kuramoto/configs/kuramoto_runtime_parity.toml \
    --epochs "${EPOCHS}" \
    --output-base experiments/kuramoto/results/diagnostic_N1000/ 2>&1 | tee "$LOG"

echo "[diag] idx=${IDX} done."
